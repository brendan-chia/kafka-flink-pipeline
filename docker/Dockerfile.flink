FROM flink:2.2.1-java17
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-dev build-essential curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/pyflink
ENV PATH="/opt/pyflink/bin:${PATH}" \
    PYTHONPATH=/opt/app \
    FLINK_PYTHON_EXECUTABLE=/opt/pyflink/bin/python
WORKDIR /opt/app
COPY requirements.txt requirements-operations.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY download_jars.sh ./
RUN sed -i 's/\r$//' download_jars.sh && bash download_jars.sh && cp -r plugins/prometheus /opt/flink/plugins/
COPY event_contract.py lakehouse_config.py ./
COPY flink-processor/pipeline.py ./flink-processor/pipeline.py
COPY monitoring/metrics.py ./monitoring/metrics.py
COPY datalens ./datalens
RUN mkdir -p /opt/flink/state && chown -R flink:flink /opt/app /opt/flink/state /opt/pyflink
USER flink
WORKDIR /opt/flink
