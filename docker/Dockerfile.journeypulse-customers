FROM python:3.11-slim
WORKDIR /app
COPY requirements-journeypulse.txt requirements-journeypulse-gateway.txt ./
RUN pip install --no-cache-dir -r requirements-journeypulse-gateway.txt
COPY journeypulse/ ./journeypulse/
COPY contracts/journeypulse/ ./contracts/journeypulse/
USER 10001:10001
CMD ["uvicorn", "journeypulse.customer_api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8021"]
